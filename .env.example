# RRE Entries — Environment Configuration Template
# Copy this file to ".env" (same folder) to customize local settings. ".env" is never committed to Git.
# NOTE: RRE works 100% offline with zero configuration out-of-the-box. Only the e-mail section below needs setting up,
# and only if you want "Forgot password" e-mails and account invitations.
# The values below are placeholders: they are NOT real credentials.

# Local Web Server Port (Default: 4000, dynamically fails over to next available if occupied)
PORT=4000

# Server Host Interface (Default: 127.0.0.1 loopback for maximum security)
HOST=127.0.0.1

# Secondary Tally XML Gateway Port (Default: 9000 for external ODBC/XML integration)
TALLY_PORT=9000

# Environment Mode: development | production
NODE_ENV=production

# Cryptographic Session Secret (Autogenerated in memory if not specified)
# SESSION_SECRET=replace_with_64_character_hex_key_for_custom_deployments

# SQLite Custom Data Directory Override (Defaults to data/100000 or AppData in packaged mode)
# TALLY_DATA_DIR=./data/100000

# ---------------------------------------------------------------------------------------------------------------------
# Password-reset e-mail through Gmail
# ---------------------------------------------------------------------------------------------------------------------
# 1. Use a Gmail (or Google Workspace) account that will SEND the e-mails.
# 2. Turn on 2-Step Verification for it:  https://myaccount.google.com/security
# 3. Create an "App password":            https://myaccount.google.com/apppasswords   (name it "RRE Entries")
#    Google shows a 16-character password once. Paste it below WITHOUT spaces. Your normal Gmail password will NOT work here.
# Remove the "# " at the start of the next two lines and put your own values in:
# RRE_SMTP_USER=your.sending.address@gmail.com
# RRE_SMTP_PASS=abcdefghijklmnop

# Optional (these are the defaults for Gmail):
# RRE_SMTP_HOST=smtp.gmail.com
# RRE_SMTP_PORT=465            # 465 = SSL, 587 = STARTTLS
# RRE_MAIL_FROM=RRE Entries <your.sending.address@gmail.com>

# The address people open RRE at. Reset links in the e-mails point here, so it must be reachable from the person's device.
# On a single PC the default is fine; on a network use this computer's address, e.g. http://192.168.1.20:4000
# RRE_PUBLIC_URL=http://127.0.0.1:4000

# ---------------------------------------------------------------------------------------------------------------------
# Other (optional)
# ---------------------------------------------------------------------------------------------------------------------
# RRE_ENFORCE_AUTH=1           # set to 1 to enforce server-side login and role checks (logins removed by default)
# RRE_MAIL_DEV_LOG=0           # 1 = (development only) print reset links in this console when e-mail is not configured

# Skip the login screen (1 = open straight into RRE as the first administrator; only for requests from this same computer).
# RRE_SKIP_LOGIN=1

# ---- Cloud database (Supabase / PostgreSQL). Leave RRE_DB unset to keep the local SQLite files. See docs/CLOUD_DATABASE.md ----
# RRE_DB=postgres
# Session pooler (port 5432) or direct connection string from Supabase > Project Settings > Database. NOT the transaction pooler (6543).
# DATABASE_URL=postgres://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Certificate check: download the CA certificate from Supabase > Project Settings > Database > SSL and point to it.
# RRE_PG_CA_FILE=C:/path/to/prod-ca-2021.crt
# Connections kept open by this server (default 10).
# RRE_PG_POOL_MAX=10
