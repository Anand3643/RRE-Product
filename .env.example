# RRE Tally — Environment Configuration Template
# Copy this file to .env to customize local server bindings and parameters.
# NOTE: RRE Tally works 100% offline with zero configuration out-of-the-box.

# Local Web Server Port (Default: 4000, dynamically fails over to next available if occupied)
PORT=4000

# Server Host Interface (Default: 127.0.0.1 loopback for maximum security)
HOST=127.0.0.1

# Secondary Tally XML Gateway Port (Default: 9000 for external ODBC/XML integration)
TALLY_PORT=9000

# Environment Mode: development | production
NODE_ENV=production

# Cryptographic Session Secret (Autogenerated in memory if not specified)
# SESSION_SECRET=replace_with_64_character_hex_key_for_custom_deployments

# SQLite Custom Data Directory Override (Defaults to data/100000 or AppData in packaged mode)
# TALLY_DATA_DIR=./data/100000
