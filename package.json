{
  "name": "rre-entries",
  "productName": "RRE Entries",
  "version": "1.0.0",
  "description": "RRE Entries Enterprise Accounting & Inventory Suite",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "test": "node test_suite.js",
    "test:load": "node scripts/load_test.js",
    "test:platform": "node test_platform.js",
    "test:gst": "node test_gst.js",
    "test:bank": "node test_bank.js",
    "test:fixes": "node test_fixes.js",
    "test:returns": "node test_returns.js",
    "test:gstengine": "node test_gstengine.js",
    "test:inventory": "node test_inventory.js",
    "test:automation": "node test_automation.js",
    "test:bulk": "node test_bulk.js",
    "test:attachments": "node test_attachments.js",
    "test:tracking": "node test_tracking.js",
    "test:insights": "node test_insights.js",
    "test:ocr": "node test_ocr.js",
    "test:companies": "node test_companies.js",
    "test:org": "node test_org.js",
    "test:approvals": "node test_approvals.js",
    "test:yearend": "node test_yearend.js",
    "test:voice": "node test_voice.js",
    "test:search": "node test_search.js",
    "test:accounts": "node test_accounts.js",
    "test:invapp": "node test_invapp.js",
    "test:invorders": "node test_invorders.js",
    "test:asr": "node test_asr.js",
    "build:win": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "install:desktop": "powershell -ExecutionPolicy Bypass -File create-shortcuts.ps1",
    "test:invreports": "node test_invreports.js",
    "test:invimport": "node test_invimport.js",
    "test:portal": "node test_portal.js",
    "test:invbridge": "node test_invbridge.js",
    "test:ledgers": "node test_tally_groups_ledgers.js",
    "setup:inventory": "python -m venv inventory-app/backend/.venv && inventory-app/backend/.venv/Scripts/python -m pip install -r inventory-app/backend/requirements.txt",
    "test:theme": "node test_theme.js",
    "test:auth": "node test_auth_unified.js",
    "admin:reset": "node scripts/set-admin-password.js",
    "mail:setup": "node scripts/setup-mail.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anand3643/RRE-Product.git"
  },
  "keywords": [
    "tally",
    "accounting",
    "erp",
    "gst",
    "inventory"
  ],
  "author": "RRE",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "nodemailer": "^7.0.13",
    "sqlite3": "^6.0.1",
    "tesseract.js": "^7.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.rre.entries",
    "productName": "RRE Entries",
    "copyright": "Copyright © 2026 RRE Entries",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "build-info.json",
      "main.js",
      "server.js",
      "tally.ini",
      "tally_icon.ico",
      "tally_icon.png",
      "rre_icon.ico",
      "rre_icon.png",
      "core/**/*",
      "modules/**/*",
      "public/**/*",
      "ocr/**/*",
      "data/**/*",
      "!data/**/inventory/**",
      "inventory-app/**/*",
      "!inventory-app/backend/.venv/**",
      "!inventory-app/frontend/node_modules/**",
      "!inventory-app/pip_install.log",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "ocr/**/*",
      "core/voice/asrWorker.js",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/onnxruntime-common/**/*",
      "node_modules/@huggingface/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "inventory-app/**/*"
    ],
    "extraResources": [
      "data/**/*",
      "tally.ini",
      "tally_icon.ico",
      "rre_icon.ico"
    ],
    "win": {
      "icon": "rre_icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "compression": "maximum"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RRE Entries"
    }
  }
}
